# ==============================================================================
# StockPilot PH — Environment Configuration Template (.env.example)
# Duplicate to .env and replace secrets prior to production deployment.
# ==============================================================================

# ── Core Server Environment ───────────────────────────────────
ENVIRONMENT=production                 # development, staging, production
PORT=8000
HOST=0.0.0.0

# ── PostgreSQL Relational Database ────────────────────────────
# Local development fallback: SQLite (auto-created at pse_local.db if unset)
# Railway / Production: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://stockpilot:your_secure_password_here@localhost:5432/stockpilot_pse

# ── Security & Authentication Keys ────────────────────────────
# CRITICAL: Generate cryptographically random keys for production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_64_character_hex_jwt_secret_key_in_production
ADMIN_MASTER_KEY=replace_with_secure_high_entropy_admin_master_key_here

# ── Cross-Origin Resource Sharing (CORS) ──────────────────────
# Comma-separated list of allowed frontend origins (no wildcards in production)
CORS_ORIGINS=https://app.stockpilot.ph,https://stockpilot.ph,http://localhost:3000

# ── Email Delivery (Resend API) ───────────────────────────────
# When RESEND_API_KEY is unset, the system logs emails to stdout (mock dev mode)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=StockPilot PH <reports@stockpilot.ph>

# ── Optional Sentiment Intelligence ───────────────────────────
# Claude Haiku enrichment for corporate disclosure filings
ANTHROPIC_API_KEY=sk-ant-api-key-here

# ── Next.js Frontend Configuration ────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
